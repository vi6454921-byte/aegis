# Скопируй в .env и заполни:  cp .env.example .env
# .env — секретный файл: не отправляй его никому и не коммить в git.

# ===== Обязательно =====
# Токен от @BotFather. Если токен где-то засветился (скриншот, чат) — в @BotFather: /revoke → вставь новый.
BOT_TOKEN=
# Твой Telegram id — числом (узнать: напиши @userinfobot). Несколько админов — через запятую: 111,222
# Можно оставить пустым: при запуске бот покажет код — отправь ему «/admin КОД», и id впишется сам.
ADMIN_IDS=
# Юзернейм бота без @ (бот всё равно сверит его с токеном при запуске)
BOT_USERNAME=aegis_samara_bot

# ===== Закреплённые админы 2 уровня =====
# Юзернеймы без @ через запятую, регистр не важен. Человек получает права, как только впервые напишет боту
# (/start), — бот запоминает его числовой id. Дальше права только по id: смена юзернейма их не снимает, новый
# владелец юзернейма ничего не получает. Другие админы закреплённого не понизят и не снимут.
# Убрать ник отсюда и перезапустить бота — снять закрепление. Пустое значение — никого не закреплять;
# если строки нет вовсе, действует badVInq,dimaslavikov1.
SENIOR_ADMIN_USERNAMES=badVInq,dimaslavikov1
# Необязательно: числовые id закреплённых админов через запятую — закрепляются сразу при запуске.
SENIOR_ADMIN_IDS=

# ===== Mini App: решения открываются прямо в Telegram =====
# Домен, A-запись которого указывает на сервер. Caddy (docker-compose) сам выпустит HTTPS-сертификат.
DOMAIN=
# Тот же домен с https:// в начале. Пусто — решения приходят HTML-файлами (подаркам домен не нужен — это ссылки).
# После запуска НЕ меняй: кнопки «Открыть решение» в отправленных сообщениях ведут на этот адрес.
WEBAPP_BASE_URL=

# ===== Стартовые значения (потом меняются в /admin → ⚙️ Настройки, и настройки из админки главнее) =====
# test — воображаемые деньги для проверки; stars — Telegram Stars; manual — перевод с проверкой чека.
# Обычно режим меняют в админке: /admin → «⭐ Включить оплату звёздами» (тестовая оплата при этом исчезает).
PAYMENTS_MODE=test
# Сколько рублей стоит 1 звезда при пересчёте цены
RUB_PER_STAR=1.75
# Лимит задач в день и с какого остатка показывать «осталось N мест»
MAX_TASKS_PER_DAY=15
SHOW_SLOTS_THRESHOLD=5
# Стартовые цифры счётчика в приветствии: «сдано работ» и «из них с первой попытки»
STATS_OFFSET_DONE=90
STATS_OFFSET_FIRST_TRY=84

# Контакт для /support и /paysupport (например @username), можно оставить пустым
SUPPORT_CONTACT=

# ===== Техническое (обычно не трогать) =====
# БД и папка данных: по умолчанию всё лежит в ./data
# DATABASE_URL=sqlite+aiosqlite:///data/aegis.db
# DATA_DIR=data
WEB_HOST=0.0.0.0
WEB_PORT=8080
# true — тестовый сервер Telegram (отдельный аккаунт и бот в test environment)
TELEGRAM_TEST_ENV=false
LOG_LEVEL=INFO
# Автобэкап БД каждый день в этот час (время Самары) и сколько бэкапов хранить
BACKUP_HOUR=4
BACKUP_KEEP=14
